# Exemplo SEM segredos. O Django lê o ambiente; este arquivo não é carregado automaticamente.
APP_ENV=development
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Defina DJANGO_SECRET_KEY localmente com valor aleatório e estável (>=50 caracteres).
# Sem DATABASE_URL, usa SQLite apenas em desenvolvimento/testes locais.
# Produção exige APP_ENV=production, chave e PostgreSQL com TLS.
# Configure DATABASE_URL no painel da hospedagem, sem versionar seu valor.
# TRUST_HTTPS_PROXY=1 somente atrás de proxy confiável que sobrescreva o cabeçalho.
